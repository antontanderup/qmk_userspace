ENCODER_MAP_ENABLE   = no
TAP_DANCE_ENABLE     = yes
CAPS_WORD_ENABLE     = yes
OS_DETECTION_ENABLE  = yes
# Needed so the Apple Globe key (Consumer page) can be held as a modifier
# for chords like Globe+E, Globe+F, etc.
